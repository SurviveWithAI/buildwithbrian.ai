---
/**
 * ProjectsSection.astro
 * The heart of the portfolio — interactive showcase of Grok Build projects.
 * Features:
 * - Category filters
 * - Live search
 * - Responsive cyberpunk grid
 * - Rich accessible modal
 * All vanilla JS. High performance.
 */

import ProjectCard from './ui/ProjectCard.astro';
import ProjectModal from './ui/ProjectModal.astro';
import { projects, categories, filterProjects, type Project, type Category } from '../data/projects';
---

<section id="projects" class="relative py-20 bg-elevated border-t border-border-subtle">
  <div class="max-w-7xl mx-auto px-6">
    <!-- Header -->
    <div class="reveal mb-9 flex flex-col lg:flex-row lg:items-end lg:justify-between gap-y-5">
      <div>
        <div class="uppercase tracking-[4.5px] text-xs text-cyan mb-4">CHAPTER 02 — THE ARSENAL</div>
        <h2 class="text-6xl md:text-7xl font-semibold tracking-[-3.6px]">Featured Builds</h2>
      </div>
      <p class="max-w-[340px] text-secondary text-[15px]">
        Every project below was built 100% with Grok Build. Click any card to see exactly how.
      </p>
    </div>

    <!-- Filters + Search -->
    <div class="reveal mb-8 flex flex-col md:flex-row gap-4 md:items-center md:justify-between">
      <!-- Category Filters -->
      <div class="flex flex-wrap gap-2" id="project-filters">
        {categories.map((cat, index) => (
          <button 
            class={`filter-pill ${cat === 'All' ? 'active' : ''}`}
            data-category={cat}
          >
            {cat}
          </button>
        ))}
      </div>

      <!-- Search -->
      <div class="relative w-full md:w-72">
        <input 
          type="text" 
          id="project-search"
          placeholder="Search projects or tech..." 
          class="w-full bg-card border border-border-subtle text-sm font-mono px-4 py-2.5 placeholder:text-muted focus:border-cyan focus:outline-none rounded"
          autocomplete="off"
        />
        <div class="absolute right-3.5 top-3 text-muted pointer-events-none">
          ⌘K
        </div>
      </div>
    </div>

    <!-- Projects Grid -->
    <div id="projects-grid" class="grid grid-cols-1 md:grid-cols-2 xl:grid-cols-3 gap-5">
      {projects.map((project) => (
        <ProjectCard project={project} />
      ))}
    </div>

    <!-- Empty state -->
    <div id="projects-empty" class="hidden py-16 text-center">
      <div class="text-cyan text-sm tracking-[3px] mb-2">NO MATCHES FOUND</div>
      <p class="text-secondary">Try adjusting your filters or search term.</p>
    </div>
  </div>

  <!-- Modal (included once) -->
  <ProjectModal />
</section>

<script>
  // Lightweight client-side filtering (show/hide pattern — very performant)
  let currentFilter = 'All';
  let currentSearch = '';

  const grid = document.getElementById('projects-grid') as HTMLDivElement;
  const emptyState = document.getElementById('projects-empty') as HTMLDivElement;
  const filtersContainer = document.getElementById('project-filters') as HTMLDivElement;
  const searchInput = document.getElementById('project-search') as HTMLInputElement;

  const cards = Array.from(grid.querySelectorAll('button[data-project-id]')) as HTMLButtonElement[];

  function applyFilters() {
    const q = currentSearch.toLowerCase().trim();
    let visibleCount = 0;

    cards.forEach((card) => {
      const category = card.querySelector('span')?.textContent?.trim() || '';
      const title = card.querySelector('h3')?.textContent?.toLowerCase() || '';
      const desc = card.querySelector('p')?.textContent?.toLowerCase() || '';
      const techText = card.textContent?.toLowerCase() || '';

      const matchesCategory = currentFilter === 'All' || category === currentFilter;
      const matchesSearch = !q || title.includes(q) || desc.includes(q) || techText.includes(q);

      if (matchesCategory && matchesSearch) {
        card.style.display = '';
        visibleCount++;
      } else {
        card.style.display = 'none';
      }
    });

    if (visibleCount === 0) {
      emptyState.classList.remove('hidden');
    } else {
      emptyState.classList.add('hidden');
    }
  }

  // Category filter buttons
  filtersContainer.querySelectorAll('button').forEach((btn) => {
    btn.addEventListener('click', () => {
      filtersContainer.querySelectorAll('button').forEach(b => b.classList.remove('active'));
      btn.classList.add('active');

      currentFilter = btn.getAttribute('data-category') || 'All';
      applyFilters();
    });
  });

  // Search (light debounce)
  let searchTimeout: number;
  searchInput.addEventListener('input', () => {
    clearTimeout(searchTimeout);
    searchTimeout = window.setTimeout(() => {
      currentSearch = searchInput.value;
      applyFilters();
    }, 90);
  });

  // Keyboard shortcut (⌘K / Ctrl+K)
  document.addEventListener('keydown', (e) => {
    if ((e.metaKey || e.ctrlKey) && e.key.toLowerCase() === 'k') {
      e.preventDefault();
      searchInput.focus();
      searchInput.select();
    }
  });

  // Wire up card clicks to open modal
  cards.forEach((card) => {
    card.addEventListener('click', () => {
      const id = card.getAttribute('data-project-id');
      // We store full project data on the window from the inline script below
      const projects = (window as any).__ALL_PROJECTS || [];
      const project = projects.find((p: any) => p.id === id);
      if (project && (window as any).__openProjectModal) {
        (window as any).__openProjectModal(project);
      }
    });
  });
</script>

<!-- Make full project data available to the modal + any future needs -->
<script is:inline define:vars={{ projects }}>
  window.__ALL_PROJECTS = projects;
</script>