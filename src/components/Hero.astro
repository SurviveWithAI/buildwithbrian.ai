---
/**
 * Hero.astro
 * Full-viewport cyberpunk hero with signature neural canvas background.
 * All effects are lightweight vanilla JS + CSS. 60fps target on modern devices.
 */
---

<section id="hero" class="relative min-h-[100dvh] flex items-center justify-center pt-20 overflow-hidden">
  <!-- Deep void background -->
  <div class="absolute inset-0 bg-void z-0"></div>

  <!-- Scanlines + very subtle grid -->
  <div class="absolute inset-0 scanlines z-10 pointer-events-none"></div>
  <div class="absolute inset-0 matrix-overlay z-10 pointer-events-none"></div>

  <!-- Soft vignette for depth -->
  <div class="absolute inset-0 z-10 pointer-events-none"
       style="background: radial-gradient(circle at 50% 40%, transparent 40%, rgba(0,0,0,0.55) 78%);"></div>

  <!-- Neural Canvas (interactive background) -->
  <canvas 
    id="neural-hero" 
    class="absolute inset-0 z-10 pointer-events-auto" 
    aria-hidden="true"
  ></canvas>

  <!-- Foreground Content -->
  <div class="relative z-20 max-w-5xl mx-auto px-6 text-center">
    <!-- Trust badge -->
    <div 
      class="group mb-6 inline-flex items-center gap-x-2 rounded-full border border-cyan/40 bg-elevated/70 px-5 py-1 text-xs font-mono tracking-[3.5px] text-cyan/90 transition-all hover:border-cyan hover:text-cyan hover:shadow-neon-cyan"
    >
      <span class="relative flex h-1.5 w-1.5">
        <span class="animate-ping absolute inline-flex h-full w-full rounded-full bg-cyan opacity-75"></span>
        <span class="relative inline-flex rounded-full h-1.5 w-1.5 bg-cyan"></span>
      </span>
      EXCLUSIVELY BUILT WITH GROK BUILD
    </div>

    <!-- Main Title with glitch on hover (split lines for perfect glitch alignment) -->
    <div class="glitch mb-7 select-none" data-text="BRIAN PHILLIPS">
      <h1 class="hero-title text-[clamp(3.05rem,12.8vw,6.75rem)] leading-[0.87] font-semibold tracking-[-4.6px] text-white">
        BRIAN<br>PHILLIPS
      </h1>
    </div>

    <!-- Tagline -->
    <div class="max-w-[620px] mx-auto mb-11">
      <p class="text-[1.65rem] md:text-[2.05rem] tracking-[-1.35px] text-white/95 font-medium mb-2.5">
        AI Survivalist
      </p>
      <p class="text-[1.32rem] md:text-[1.65rem] text-teal/95 font-light tracking-[-0.6px] leading-tight">
        Adapt. Survive. Thrive.<br class="hidden sm:block"> In the age of AI.
      </p>
    </div>

    <!-- Primary CTAs -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4">
      <a 
        href="#projects" 
        class="neon-btn text-[15px] md:text-base px-10 py-[15px] tracking-[1.5px]"
      >
        EXPLORE THE BUILDS
      </a>
      <a 
        href="https://x.com/survivewithai" 
        target="_blank" 
        rel="noopener noreferrer"
        class="neon-btn-teal text-[15px] md:text-base px-10 py-[15px] tracking-[1.5px]"
      >
        FOLLOW @survivewithai
      </a>
    </div>

    <!-- Micro provenance line -->
    <div class="mt-8 text-[10px] font-mono tracking-[3px] text-cyan/50">
      100% PROTOTYPED &amp; SHIPPED WITH GROK BUILD (xAI)
    </div>
  </div>

  <!-- Scroll indicator -->
  <div class="absolute bottom-9 left-1/2 -translate-x-1/2 hidden lg:flex flex-col items-center gap-y-1.5 text-[10px] font-mono tracking-[3.5px] text-secondary/40 z-20">
    SCROLL TO ENTER THE VOID
    <div class="h-px w-9 bg-current mt-0.5"></div>
  </div>
</section>

<script>
  // =========================================================
  // SIGNATURE NEURAL CANVAS — Cyberpunk Hero Background
  // High-performance, fully vanilla, respects reduced motion.
  // =========================================================

  function initNeuralCanvas() {
    const canvas = document.getElementById('neural-hero') as HTMLCanvasElement | null;
    if (!canvas) return;

    const ctx = canvas.getContext('2d', { alpha: true, desynchronized: true });
    if (!ctx) return;

    let width = 0;
    let height = 0;
    let dpr = 1;
    let nodes: Array<{ x: number; y: number; vx: number; vy: number; r: number }> = [];
    let packets: Array<{ from: number; to: number; progress: number; speed: number }> = [];
    let animationFrame = 0;
    let lastPacketTime = 0;
    let isPaused = false;

    const prefersReduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    function resize() {
      const rect = canvas.getBoundingClientRect();
      width = rect.width;
      height = rect.height;
      dpr = Math.min(window.devicePixelRatio || 1, 2.5);

      canvas.width = Math.floor(width * dpr);
      canvas.height = Math.floor(height * dpr);
      canvas.style.width = `${width}px`;
      canvas.style.height = `${height}px`;

      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);

      // Node count: richer on desktop, lighter on mobile
      const area = width * height;
      const baseCount = Math.floor(Math.min(92, Math.max(38, area / 9200)));
      const targetCount = window.innerWidth < 768 ? Math.floor(baseCount * 0.42) : baseCount;

      nodes = Array.from({ length: targetCount }, () => ({
        x: Math.random() * width,
        y: Math.random() * height,
        vx: (Math.random() - 0.5) * 0.32,
        vy: (Math.random() - 0.5) * 0.32,
        r: Math.random() * 1.85 + 1.15,
      }));

      packets = [];
    }

    // More robust resizing for hero canvas
    const heroSection = document.getElementById('hero');

    const resizeObserver = new ResizeObserver(() => {
      resize();
    });

    if (heroSection) {
      resizeObserver.observe(heroSection);
    } else {
      resizeObserver.observe(canvas);
    }

    // Force multiple resizes to handle late layout (fonts, flex, etc.)
    requestAnimationFrame(() => resize());
    requestAnimationFrame(() => resize());
    setTimeout(resize, 100);
    setTimeout(resize, 300);

    window.addEventListener('load', resize, { once: true });

    // Mouse state
    let mouseX = width * 0.5;
    let mouseY = height * 0.42;
    let mouseActive = false;

    function onMouseMove(e: MouseEvent) {
      const rect = canvas.getBoundingClientRect();
      mouseX = e.clientX - rect.left;
      mouseY = e.clientY - rect.top;
      mouseActive = true;
    }

    function onMouseLeave() {
      mouseActive = false;
    }

    canvas.addEventListener('mousemove', onMouseMove, { passive: true });
    canvas.addEventListener('mouseleave', onMouseLeave, { passive: true });

    // Create a traveling data packet between two nodes
    function spawnPacket() {
      if (nodes.length < 3) return;

      // Find a reasonably close pair
      let bestI = 0, bestJ = 1, bestDist = Infinity;
      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const d = Math.hypot(dx, dy);
          if (d > 38 && d < 165 && d < bestDist) {
            bestDist = d;
            bestI = i;
            bestJ = j;
          }
        }
      }

      packets.push({
        from: bestI,
        to: bestJ,
        progress: 0,
        speed: 0.014 + Math.random() * 0.011,
      });
    }

    function updateAndDraw() {
      if (isPaused || prefersReduced) {
        // Draw a very minimal static version when reduced motion
        ctx.fillStyle = 'rgba(10,10,10,0.82)';
        ctx.fillRect(0, 0, width, height);

        ctx.fillStyle = 'rgba(0, 245, 255, 0.35)';
        for (const n of nodes) {
          ctx.beginPath();
          ctx.arc(n.x, n.y, n.r * 0.7, 0, Math.PI * 2);
          ctx.fill();
        }
        return;
      }

      ctx.fillStyle = 'rgba(10, 10, 10, 0.78)';
      ctx.fillRect(0, 0, width, height);

      const now = performance.now();

      // Spawn data packets periodically
      if (now - lastPacketTime > 680 && packets.length < 11) {
        spawnPacket();
        lastPacketTime = now;
      }

      // Update nodes
      const influenceRadius = 215;
      const influenceStrength = 0.021;

      for (let i = 0; i < nodes.length; i++) {
        const n = nodes[i];

        // Mouse influence
        if (mouseActive) {
          const dx = mouseX - n.x;
          const dy = mouseY - n.y;
          const dist = Math.hypot(dx, dy);

          if (dist < influenceRadius && dist > 3) {
            const force = (1 - dist / influenceRadius) * influenceStrength;
            n.vx += (dx / dist) * force;
            n.vy += (dy / dist) * force;

            // Occasional pulse ring when very close
            if (dist < 48 && Math.random() < 0.08) {
              ctx.strokeStyle = 'rgba(0, 245, 255, 0.25)';
              ctx.lineWidth = 0.9;
              ctx.beginPath();
              ctx.arc(n.x, n.y, 19, 0, Math.PI * 2);
              ctx.stroke();
            }
          }
        }

        n.x += n.vx;
        n.y += n.vy;

        // Gentle friction + slight wander
        n.vx *= 0.978;
        n.vy *= 0.978;
        n.vx += (Math.random() - 0.5) * 0.018;
        n.vy += (Math.random() - 0.5) * 0.018;

        // Soft edge wrapping (feels more organic than bouncing)
        const pad = 12;
        if (n.x < pad) { n.x = width - pad; }
        if (n.x > width - pad) { n.x = pad; }
        if (n.y < pad) { n.y = height - pad; }
        if (n.y > height - pad) { n.y = pad; }
      }

      // Draw connections (cyan neural web)
      ctx.strokeStyle = '#00f5ff';
      ctx.lineWidth = 0.75;

      for (let i = 0; i < nodes.length; i++) {
        for (let j = i + 1; j < nodes.length; j++) {
          const dx = nodes[i].x - nodes[j].x;
          const dy = nodes[i].y - nodes[j].y;
          const dist = Math.hypot(dx, dy);

          if (dist < 138) {
            const alpha = (1 - dist / 138) * 0.42;
            ctx.globalAlpha = alpha;
            ctx.beginPath();
            ctx.moveTo(nodes[i].x, nodes[i].y);
            ctx.lineTo(nodes[j].x, nodes[j].y);
            ctx.stroke();
          }
        }
      }
      ctx.globalAlpha = 1;

      // Draw nodes (cyan + subtle green core)
      for (const n of nodes) {
        // Outer soft glow
        ctx.fillStyle = 'rgba(0, 245, 255, 0.18)';
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r * 2.35, 0, Math.PI * 2);
        ctx.fill();

        // Core node
        ctx.fillStyle = '#00f5ff';
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r, 0, Math.PI * 2);
        ctx.fill();

        // Tiny bright center
        ctx.fillStyle = '#ffffff';
        ctx.beginPath();
        ctx.arc(n.x, n.y, n.r * 0.32, 0, Math.PI * 2);
        ctx.fill();
      }

      // Draw traveling data packets (teal/green)
      ctx.strokeStyle = '#00d4aa';
      ctx.fillStyle = '#22c55e';
      ctx.lineWidth = 1.1;

      for (let p = packets.length - 1; p >= 0; p--) {
        const pkt = packets[p];
        const a = nodes[pkt.from];
        const b = nodes[pkt.to];

        if (!a || !b) {
          packets.splice(p, 1);
          continue;
        }

        pkt.progress += pkt.speed;
        if (pkt.progress >= 1) {
          packets.splice(p, 1);
          continue;
        }

        const x = a.x + (b.x - a.x) * pkt.progress;
        const y = a.y + (b.y - a.y) * pkt.progress;

        // Glowing trail
        ctx.globalAlpha = 0.35;
        ctx.beginPath();
        ctx.arc(x, y, 3.8, 0, Math.PI * 2);
        ctx.fill();

        // Bright head
        ctx.globalAlpha = 0.95;
        ctx.beginPath();
        ctx.arc(x, y, 1.65, 0, Math.PI * 2);
        ctx.fill();
      }
      ctx.globalAlpha = 1;

      // Occasional subtle node pulse (very rare)
      if (Math.random() < 0.018) {
        const n = nodes[Math.floor(Math.random() * nodes.length)];
        ctx.strokeStyle = 'rgba(34, 197, 94, 0.35)';
        ctx.lineWidth = 1.3;
        ctx.beginPath();
        ctx.arc(n.x, n.y, 22, 0, Math.PI * 2);
        ctx.stroke();
      }

      animationFrame = requestAnimationFrame(updateAndDraw);
    }

    // Visibility handling (pause when tab hidden for performance)
    function handleVisibility() {
      isPaused = document.hidden;
      if (!isPaused && !animationFrame) {
        lastPacketTime = performance.now();
        animationFrame = requestAnimationFrame(updateAndDraw);
      }
    }
    document.addEventListener('visibilitychange', handleVisibility, { passive: true });

    // Resize handler (debounced)
    let resizeTimeout: number;
    const onResize = () => {
      clearTimeout(resizeTimeout);
      resizeTimeout = window.setTimeout(() => {
        resize();
      }, 80);
    };
    window.addEventListener('resize', onResize, { passive: true });

    // Initial boot
    resize();

    // Start the loop
    lastPacketTime = performance.now() - 420;
    animationFrame = requestAnimationFrame(updateAndDraw);

    // Seed a couple packets quickly for instant visual interest
    setTimeout(() => { if (!prefersReduced) spawnPacket(); }, 420);
    setTimeout(() => { if (!prefersReduced) spawnPacket(); }, 980);

    // Cleanup hook for Astro navigation (future-proof)
    document.addEventListener('astro:before-swap', () => {
      cancelAnimationFrame(animationFrame);
      window.removeEventListener('resize', onResize);
      document.removeEventListener('visibilitychange', handleVisibility);
    }, { once: true });
  }

  // Boot the hero canvas
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initNeuralCanvas, { once: true });
  } else {
    initNeuralCanvas();
  }
</script>