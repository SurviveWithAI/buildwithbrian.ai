---

<div class="grid md:grid-cols-2 lg:grid-cols-4 gap-5">
  {insights.map((insight, index) => (
    <a 
      href={insight.xUrl}
      target="_blank"
      rel="noopener noreferrer"
      class="insight-card cyber-card group block p-7 reveal"
      style={`transition-delay: ${index * 50}ms`}
    >
      <!-- Meta -->
      <div class="flex items-center justify-between text-xs font-mono mb-5">
        <div class="text-muted tracking-[2px]">{insight.date}</div>
        <div class="text-cyan/70">{insight.readTime} read</div>
      </div>

      <!-- Title -->
      <h3 class="insight-title font-semibold text-[17px] leading-tight tracking-[-0.3px] text-white mb-4 group-hover:text-teal transition-colors duration-200">
        {insight.title}
      </h3>

      <!-- Excerpt -->
      <p class="text-secondary text-[14px] leading-snug line-clamp-3 mb-6">
        {insight.excerpt}
      </p>

      <!-- CTA -->
      <div class="flex items-center text-xs font-mono tracking-[2.5px] text-teal group-hover:text-cyan transition-colors">
        READ ON X 
        <span class="ml-1.5 group-hover:ml-2 transition-all">→</span>
      </div>
    </a>
  ))}
</div>